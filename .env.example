# Copy to .env. Never commit real credentials.
HOST=127.0.0.1
PORT=3000
VORTEX_DB_PATH=.vortex/vortex.sqlite
# Required (at least 32 random characters) when HOST=0.0.0.0.
# Public hosting must provide HTTPS for Secure session cookies.
VORTEX_AUTH_TOKEN=

OPENAI_API_KEY=
OPENAI_PRIMARY_MODEL=gpt-6-astra
OPENAI_FAST_MODEL=gpt-6-astra
OPENAI_REVIEW_MODEL=gpt-6-astra
OPENAI_PRIMARY_MODE=responses
OPENAI_REVIEW_MODE=responses
OPENAI_TRANSCRIPTION_MODEL=whisper-1

ANTHROPIC_API_KEY=
ANTHROPIC_PRIMARY_MODEL=claude-fable-5-1
ANTHROPIC_BALANCED_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
ANTHROPIC_REVIEW_MODEL=claude-opus-5-5
PRIMARY_PROVIDER=anthropic
REVIEW_PROVIDER=openai
ENABLE_CROSS_MODEL_REVIEW=true
MIN_REVIEW_SCORE=0.80
# responses: analyze/propose code. agents: create an OpenAI-hosted session.
# Agents API access must be enabled in your OpenAI project. No GitHub credentials
# or repository mounts are provisioned automatically by this application.
CODING_MODE=responses

FPL_BASE_URL=https://fantasy.premierleague.com/api
# Optional admin-configured MCP server; list exact tools vetted as read-only.
MCP_SERVER_URL=
MCP_READ_TOOLS=
MCP_TOKEN=
