# OpenAI / managed Codex harness
OPENAI_API_KEY=
OPENAI_PRIMARY_MODEL=gpt-6-astra
OPENAI_REVIEW_MODEL=gpt-6-astra
OPENAI_PRIMARY_MODE=agents
OPENAI_REVIEW_MODE=responses

# File intelligence / multimodal analysis
VORTEX_TRANSCRIPTION_MODEL=gpt-transcribe
VORTEX_VISION_MODEL=gpt-6-astra
VORTEX_FFMPEG_PATH=ffmpeg
VORTEX_FFPROBE_PATH=ffprobe

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_PRIMARY_MODEL=claude-fable-5-1
ANTHROPIC_REVIEW_MODEL=claude-opus-5-5

# Routing: Fable handles the hardest FPL reasoning by default;
# OpenAI independently reviews. Coding tasks can explicitly route to OpenAI Agents.
PRIMARY_PROVIDER=anthropic
REVIEW_PROVIDER=openai
ENABLE_CROSS_MODEL_REVIEW=true
MIN_REVIEW_SCORE=0.80

# FPL
FPL_BASE_URL=https://fantasy.premierleague.com/api

# Upstream monitoring
RUFLO_REPOSITORY=ruvnet/ruflo
