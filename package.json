{
  "name": "fpl-vortex-agent",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "types": "./dist/public-api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/public-api.d.ts",
      "import": "./dist/public-api.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "node --test dist/core/*.test.js dist/tools/*.test.js dist/agents/*.test.js dist/sandbox/*.test.js dist/memory/*.test.js dist/files/*.test.js dist/fpl/*.test.js",
    "web:install": "npm --prefix apps/vortex-web install --no-audit --no-fund",
    "web:typecheck": "npm --prefix apps/vortex-web run typecheck",
    "web:build": "npm --prefix apps/vortex-web run build",
    "check": "npm run typecheck && npm run build && npm test && npm run web:install && npm run web:typecheck && npm run web:build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@modelcontextprotocol/client": "2.3.0",
    "adm-zip": "0.6.1",
    "fast-xml-parser": "5.11.2",
    "mammoth": "1.13.0",
    "openai": "7.28.0",
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "7.0.2"
  }
}
