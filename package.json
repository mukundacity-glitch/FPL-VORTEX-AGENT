{
  "name": "fpl-vortex-agent",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "node --test dist/core/*.test.js dist/tools/*.test.js dist/agents/*.test.js dist/sandbox/*.test.js dist/memory/*.test.js",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@modelcontextprotocol/client": "2.3.0",
    "openai": "7.28.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "7.0.2"
  }
}
